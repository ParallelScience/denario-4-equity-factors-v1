        ax_diff.legend()
        ax_diff.grid(True, linestyle='--', alpha=0.7)

    fig.tight_layout()
    plot1_path = os.path.join(data_dir, "IR_Decay_Combined_1_" + timestamp + ".png")
    fig.savefig(plot1_path, dpi=300)
    plt.close(fig)
    print("Plot saved to " + plot1_path)
    
    # Plot 2: Noise-to-Signal Ratio vs N
