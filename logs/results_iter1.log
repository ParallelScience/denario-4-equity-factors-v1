import sys
import os
sys.path.insert(0, os.path.abspath("codebase"))
import pickle
import numpy as np
import pandas as pd
import os

def compute_fmp_weights(Sigma, B):
    X = np.linalg.solve(Sigma, B)
    Y = B.T @ X
    W = X @ np.linalg.inv(Y)
    return W

if __name__ == '__main__':
    data_dir = 'data/'
