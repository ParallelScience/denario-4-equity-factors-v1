        ax_ir.plot(ns, ir_ideal, 'k--', label='Ideal FMP', marker='o')
        ax_ir.plot(ns, ir_ols, 'b-', label='OLS-FMP', marker='s')
        ax_ir.fill_between(ns, ci_ols_lower, ci_ols_upper, color='blue', alpha=0.15)
